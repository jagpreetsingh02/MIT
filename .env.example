# Local single-user mode defaults to loopback. Production requires API_TOKEN.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/rippleguard.sqlite
API_TOKEN=
PUBLIC_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Private repository access: mounted PKCS8 PEM, outside the repository.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_IDS=
GITHUB_ALLOWED_REPOS=
GITHUB_WEBHOOK_SECRET=
NVD_API_KEY=
MAX_ENRICH_PACKAGES=2000
MAX_NVD_CVES=3
OSS_INDEX_EMAIL=
OSS_INDEX_TOKEN=
OTEL_SERVICE_NAME=rippleguard
OTEL_EXPORTER_OTLP_ENDPOINT=
# Only the GitHub Actions update job uses this; runtime never reads it.
OPENAI_API_KEY=

# OTTER explanation provider (server only; never expose in VITE_ variables).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
