# Local mode defaults to loopback. The API is public; abuse limits below apply per client IP.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/rootline.sqlite
# Reverse-proxy hop count used to find the real client IP for rate limits (e.g. 1). Leave empty locally.
TRUST_PROXY=
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated browser origins allowed to call this API cross-origin (CORS),
# e.g. the deployed Vercel frontend: https://rootline.vercel.app
ALLOWED_ORIGINS=
LOG_LEVEL=info
# Optional server-side GitHub token for public repository scans (read-only, no scopes needed).
# Avoids GitHub's anonymous rate limit on shared hosting IPs. Backend-only: never prefix with VITE_.
GITHUB_TOKEN=
# Private repository access: mounted PKCS8 PEM, outside the repository.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_IDS=
GITHUB_ALLOWED_REPOS=
GITHUB_WEBHOOK_SECRET=
NVD_API_KEY=
MAX_ENRICH_PACKAGES=2000
MAX_NVD_CVES=3
OSS_INDEX_EMAIL=
OSS_INDEX_TOKEN=
OTEL_SERVICE_NAME=rootline
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTTER assistant (Groq). Server-side only; never exposed to the browser. Leave empty to disable OTTER.
GROQ_API_KEY=
# Per-client limits (requests per minute).
API_RATE_LIMIT_PER_MINUTE=300
SCAN_RATE_LIMIT_PER_MINUTE=10
ANALYZE_RATE_LIMIT_PER_MINUTE=20
SIMULATE_RATE_LIMIT_PER_MINUTE=120
SBOM_RATE_LIMIT_PER_MINUTE=30
OTTER_RATE_LIMIT_PER_MINUTE=30
TRANSCRIBE_RATE_LIMIT_PER_MINUTE=12
# Service-wide ceilings (per hour), bounding total cost across all clients.
GITHUB_SCANS_PER_HOUR=120
OTTER_REQUESTS_PER_HOUR=600
TRANSCRIPTIONS_PER_HOUR=200
# Only the GitHub Actions update job uses this; runtime never reads it.
OPENAI_API_KEY=
